{
  "name": "@isimplifyme/aeo-scan",
  "version": "0.2.0",
  "description": "Unified iSM AEO scanner — source-parse and fetch-mode page auditing against the AEO Standard. Replaces the per-repo aeo-check.ts / aeo-scan.mjs / aeo-audit.mjs copies.",
  "type": "module",
  "bin": {
    "aeo-scan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "stage:npmjs": "node scripts/pack-npmjs.mjs",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iSimplifyMe/aeo-scan.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
